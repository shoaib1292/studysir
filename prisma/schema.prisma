generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role: STUDENT | PARENT | TEACHER
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  role          String   @default("STUDENT")
  avatar        String?
  coverImage    String?
  headline      String? // e.g. "Business Coach"
  bio           String?
  city          String?
  country       String? @default("India")
  gender        String?
  qualification String?
  subjects      String? // comma separated
  languages     String? // comma separated
  feeMin        Float?
  feeMax        Float?
  coins         Int      @default(0)
  money         Float    @default(0)
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tuitionPosts    TuitionPost[]
  courses         Course[]
  digitalGoods    DigitalGood[]
  transactions    CoinTransaction[]
  teacherLinks    Connection[] @relation("teacherLink")
  studentLinks    Connection[] @relation("studentLink")
  messagesSent    Message[]
  reviewsReceived Review[]     @relation("reviewReceived")
  reviewsGiven    Review[]     @relation("reviewGiven")
  blocksMade      Block[]      @relation("blocker")
  blocksReceived  Block[]      @relation("blocked")
  notifications   Notification[]
  likes           Like[]
  availabilities  Availability[]
}

// mode: ONLINE | HOME | CENTER  | status: OPEN | HIRED | CLOSED
model TuitionPost {
  id            String   @id @default(cuid())
  authorId      String
  author        User     @relation(fields: [authorId], references: [id])
  title         String
  description   String
  mode          String   @default("ONLINE")
  city          String?
  subjects      String?
  languages     String?
  qualification String?
  feeMin        Float    @default(0)
  feeMax        Float    @default(0)
  timing        String?
  coinCost      Int      @default(10)
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  connections Connection[]
}

// status: PENDING | ACTIVE | HIRED | REJECTED | EXPIRED  (REFUNDED reflected via refunded flag)
model Connection {
  id            String       @id @default(cuid())
  teacherId     String
  teacher       User         @relation("teacherLink", fields: [teacherId], references: [id])
  studentId     String
  student       User         @relation("studentLink", fields: [studentId], references: [id])
  tuitionPostId String?
  tuitionPost   TuitionPost? @relation(fields: [tuitionPostId], references: [id])
  coinsSpent    Int          @default(0)
  status        String       @default("PENDING")
  chatStartedAt DateTime?
  decidedAt     DateTime?
  refunded      Boolean      @default(false)
  blockedBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  messages     Message[]
  transactions CoinTransaction[]
}

model Message {
  id           String     @id @default(cuid())
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id])
  senderId     String
  sender       User       @relation(fields: [senderId], references: [id])
  content      String
  system       Boolean    @default(false)
  readAt       DateTime?
  createdAt    DateTime   @default(now())
}

model Course {
  id             String   @id @default(cuid())
  teacherId      String
  teacher        User     @relation(fields: [teacherId], references: [id])
  title          String
  description    String
  cover          String?
  language       String?
  subject        String?
  duration       String?
  timing         String?
  classDuration  String?
  classesPerWeek String?
  format         String?
  fee            Float    @default(0)
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// type: WELCOME | PURCHASE | SPEND_CONTACT | REFUND_AUTO | REFUND_REJECT | HIRE_BONUS | MONETIZE
model CoinTransaction {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  amount       Int
  type         String
  description  String?
  connectionId String?
  createdAt    DateTime    @default(now())
  connection   Connection? @relation(fields: [connectionId], references: [id])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("blocked", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Review {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation("reviewGiven", fields: [authorId], references: [id])
  targetId  String
  target    User     @relation("reviewReceived", fields: [targetId], references: [id])
  rating    Int      @default(5)
  comment   String?
  createdAt DateTime @default(now())
}

// targetType: TEACHER | COURSE | GOOD | TUITION
model Like {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
}

// type: CONNECT_REQUEST | MESSAGE | HIRED | REJECTED | REFUND | BLOCK | SYSTEM
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Availability {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  day    String
  slots  String
}

// Money-wallet purchase of a digital good
model Purchase {
  id         String      @id @default(cuid())
  userId     String
  goodId     String
  good       DigitalGood @relation(fields: [goodId], references: [id])
  amount     Float
  createdAt  DateTime    @default(now())
}

model DigitalGood {
  id          String   @id @default(cuid())
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id])
  title       String
  description String
  image       String?
  price       Float    @default(0)
  fileUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases Purchase[]
}
